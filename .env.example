# =============================================================================
# TrizenHR Backend — copy to .env (local) or CapRover App Configs (prod)
# =============================================================================

PORT=5000
NODE_ENV=development

# MongoDB — set MONGO_DB when URI has no database path (avoids default "test")
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=trizenhr

JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000,http://trizenventures.localhost:3000,https://trizenhr.com

# Frontend / tenant URLs
# Production: FRONTEND_URL=https://trizenhr.com, APP_DOMAIN=trizenhr.com, FRONTEND_PROTOCOL=https
# Local dev:  FRONTEND_URL=http://localhost:3000, APP_DOMAIN=localhost, FRONTEND_PROTOCOL=http
FRONTEND_URL=https://trizenhr.com
APP_DOMAIN=trizenhr.com
TENANT_SUBDOMAIN=
FRONTEND_PORT=3000
FRONTEND_PROTOCOL=https

# Email service — must match email service SERVICE_AUTH_TOKEN
EMAIL_SERVICE_URL=http://localhost:4007
EMAIL_SERVICE_AUTH_TOKEN=your_super_secret_token_min_32_chars_long_12345

# Staff invite footers / HR-facing copy
TRIZEN_SUPPORT_EMAIL=support@trizenventures.com
# Org onboarding + company-admin invites (platform sender)
TRIZEN_PLATFORM_SUPPORT_EMAIL=support@trizenhr.com

INVITATION_BASE_URL=https://trizenhr.com/auth/set-password
INVITATION_EXPIRY_DAYS=7

# Demo invitation defaults (overridable in Super Admin platform settings)
DEMO_INVITE_LINK_TTL_HOURS=48
DEMO_ACCESS_TTL_DAYS=7

# MinIO / S3-compatible storage
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_REGION_NAME=eu-east-1
MINIO_BROWSER_REDIRECT_URL=https://trizenhr.llp.trizenventures.com
MINIO_SERVER_URL=https://trizenhr-api.llp.trizenventures.com
MINIO_ENDPOINT=https://trizenhr-api.llp.trizenventures.com
MINIO_BUCKET_NAME=attendence-image-checkin
MINIO_PROFILE_BUCKET_NAME=profile-photos
MINIO_CHECKIN_BUCKET_NAME=attendence-image-checkin

# Microsoft OAuth (optional)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=https://trizenhr.com/auth/microsoft/callback

# MinIO configuration
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password
MINIO_REGION_NAME=eu-east-1
MINIO_BROWSER_REDIRECT_URL=https://trizenhr.llp.trizenventures.com
MINIO_SERVER_URL=https://trizenhr-api.llp.trizenventures.com
MINIO_ENDPOINT=https://trizenhr-api.llp.trizenventures.com
MINIO_BUCKET_NAME=attendence-image-checkin
MINIO_PROFILE_BUCKET_NAME=profile-photos
MINIO_CHECKIN_BUCKET_NAME=attendence-image-checkin
