# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB (if URI has no database path, set MONGO_DB — avoids default "test" db)
MONGO_URI=
# Required on CapRover when MONGO_URI has no /dbname (otherwise Atlas uses "test")
MONGO_DB=trizenhr

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated). Tenant dev hosts like http://acme.localhost:3000 are allowed automatically.
CORS_ORIGIN=http://localhost:3000

# Email Service Integration (SERVICE_AUTH_TOKEN must match trizenhr_email_service)
EMAIL_SERVICE_URL=http://localhost:4007
EMAIL_SERVICE_AUTH_TOKEN=your_super_secret_token_min_32_chars_long_12345
# Staff invite footers / HR-facing copy
TRIZEN_SUPPORT_EMAIL=support@trizenventures.com
# Org onboarding + company-admin invites (must match email service EMAIL_FROM_ADDRESS)
TRIZEN_PLATFORM_SUPPORT_EMAIL=support@trizenhr.com

# Invitation links (tenant subdomain used when org has subdomain set)
FRONTEND_URL=http://localhost:3000
APP_DOMAIN=localhost
# Empty = tenant at abc.trizenhr.com. Set to "org" only if you use abc.org.trizenhr.com
TENANT_SUBDOMAIN=
FRONTEND_PORT=3000
FRONTEND_PROTOCOL=http
INVITATION_BASE_URL=http://localhost:3000/auth/set-password
INVITATION_EXPIRY_DAYS=7

# MINIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_REGION_NAME=
MINIO_BROWSER_REDIRECT_URL=
MINIO_SERVER_URL=
MINIO_ENDPOINT=
MINIO_BUCKET_NAME=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=